# Public browser configuration only. Never place service-role, database, or
# provider keys in this file: every VITE_* value becomes part of the browser build.

# CISPAR Platform API. Local development uses the platform default port.
VITE_PLATFORM_API_URL=http://localhost:8787

# Required only while the landing uses Supabase directly for customer sign-in.
# These are public Supabase browser values, never a service-role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_supabase_anon_key
